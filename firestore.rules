rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isGM() {
      return isSignedIn() && (
        request.auth.token.email == "leaog.8@gmail.com" ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "GM"
      );
    }

    function isOwner(email_dono) {
      return isSignedIn() && request.auth.token.email == email_dono;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- USERS REGISTRATION ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        isGM() || 
        (request.auth.uid == userId && !request.resource.data.keys().hasAny(['role']))
      );
      allow delete: if isGM();
    }

    // --- CONFIGURATION (DISCORD MAPPINGS, GM SETTINGS) ---
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isGM();
    }

    // --- DISCORD CHANNELS (GM MANAGES, ALL USERS READ) ---
    match /discord_channels/{channelId} {
      allow read: if isSignedIn();
      allow write: if isGM();
    }

    // --- DISCORD NOTEBOOK MESSAGES ---
    match /discord_notebook_messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.authorName != null ||
        request.auth.token.email == "discord-bot@system.local"
      );
      allow update: if isSignedIn() && (
        isGM() || 
        request.auth.token.email == "discord-bot@system.local" ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['pinned', 'pinnedBy', 'pinnedAt'])
      );
      allow delete: if isGM() || request.auth.token.email == "discord-bot@system.local" || (isSignedIn() && resource.data.authorEmail == request.auth.token.email);
    }

    // --- CHARACTERS ---
    match /characters/{charId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isGM();

      // Alternate Versions / Transformations Subcollection
      match /versions/{versionId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isGM();
      }
    }

    // --- CHAT MESSAGES ---
    match /messages/{msgId} {
      allow get: if isSignedIn() && (
        isGM() ||
        resource.data.remetente_email == request.auth.token.email ||
        resource.data.destinatario == request.auth.token.email ||
        (
          resource.data.destinatario == "TODOS" &&
          (!resource.data.keys().hasAny(['ocultada']) || resource.data.ocultada == false)
        )
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.remetente_email == request.auth.token.email || request.auth.token.email == "discord-bot@system.local");
      allow update, delete: if isGM() || request.auth.token.email == "discord-bot@system.local";
    }

    // --- ARENA STATE ---
    match /arena/{arenaId} {
      allow read: if isSignedIn();
      allow write: if isGM();

      // Tokens Subcollection (GM can create/delete; Players and GM can move positions)
      match /tokens/{tokenId} {
        allow read: if isSignedIn();
        allow create, delete: if isGM();
        allow update: if isSignedIn() && (
          isGM() || 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x', 'y'])
        );
      }
    }

    // --- GAME STATUSES Managed by GM ---
    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow write: if isGM();
    }

    // --- CAMPAIGN NOTES ---
    match /campaign_notes/{noteId} {
      allow get: if isSignedIn() && (
        resource.data.tipo == "PUBLIC" ||
        isGM() ||
        resource.data.autor_uid == request.auth.uid
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.autor_uid == request.auth.uid &&
        (request.resource.data.tipo != "GM_ONLY" || isGM())
      );
      allow update: if isSignedIn() && (
        isGM() || (
          resource.data.autor_uid == request.auth.uid &&
          request.resource.data.autor_uid == request.auth.uid &&
          (request.resource.data.tipo != "GM_ONLY" || isGM())
        )
      );
      allow delete: if isGM() || (isSignedIn() && resource.data.autor_uid == request.auth.uid);
    }
  }
}
